{
  "hosting": {
    "public": "public",
    "redirects": [
      {
        "source": "/:path*",
        "destination": "https://ecole-km-backend--collectif-ecole-km.europe-west4.hosted.app/:path*",
        "type": 301
      }
    ]
  },
  "apphosting": {

    "backendId": "ecole-km-backend",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ],
    "alwaysDeployFromSource": true
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "firestore": [
    {
      "database": "ecole-db",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
