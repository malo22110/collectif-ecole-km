rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /commentaires/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /articles/{articleId} {
      allow read: if resource == null || resource.data.status == 'published' || request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    match /membres/{membreId} {
      allow create: if (request.resource.data.keys().hasAll(['prenom', 'nom', 'email', 'dateInscription', 'status'])
                    && request.resource.data.status == 'pending') || (request.auth != null);
      allow read, update, delete: if request.auth != null;
    }
    
    // PETITION: Tout le monde peut lire et créer des signatures
    match /signatures/{sigId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
    
    // STATS: Tout le monde peut lire et mettre à jour les compteurs publics
    match /stats/{statId} {
      allow read, write: if true;
    }

    match /mailOutbox/{mailId} {
      allow create, read, update, delete: if request.auth != null;
    }

    match /magicLinks/{linkId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
