rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    
    match /pages/{pageId} {
      allow read: if true;
      allow create: if isAdmin();
      // [SPEC-CMS-HISTORY-01] Les mises à jour de la page fiscale passent par l’API transactionnelle qui archive chaque état précédent.
      allow update, delete: if isAdmin() && pageId != 'historique';
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if hasRole('faq');
    }

    match /commentaires/{commentId} {
      allow read: if true;
      allow create: if isMembreValide();
      allow update, delete: if isAdmin();
    }
    function isMembreValide() {
      return request.auth != null && get(/databases/$(database)/documents/membres/$(request.auth.token.email)).data.status == 'validated';
    }

    match /articles/{articleId} {
      allow read: if resource == null || resource.data.status == 'published' || isAdmin() || (request.auth != null && resource.data.authorEmail == request.auth.token.email);
      allow create: if isAdmin() || (
        isMembreValide() &&
        request.resource.data.status == 'draft' &&
        request.resource.data.authorEmail == request.auth.token.email
      );
      allow update: if isAdmin() || (
        request.auth != null &&
        resource.data.authorEmail == request.auth.token.email &&
        request.resource.data.status == 'draft'
      );
      allow delete: if isAdmin();
    }


    match /presse/{presseId} {
      allow read: if true;
      allow create, update, delete: if hasRole('presse');
    }

    match /journalistes/{journalisteId} {
      allow read, write: if hasRole('presse');
    }

    function isAdmin() {
      let membreData = get(/databases/$(database)/documents/membres/$(request.auth.token.email)).data;
      return request.auth != null && (
        request.auth.token.email == 'lecam.malo@gmail.com' || 
        request.auth.token.email == 'contact@collectif-ecole-km.fr' || 
        request.auth.token.email == 'collectif.ecole.km@gmail.com' ||
        (membreData != null && membreData.role == 'admin') ||
        (membreData != null && membreData.roles != null && 'admin' in membreData.roles)
      );
    }
    
    function hasRole(roleName) {
      let membreData = get(/databases/$(database)/documents/membres/$(request.auth.token.email)).data;
      return isAdmin() || (
        request.auth != null && membreData != null && (
          membreData.role == roleName ||
          (membreData.roles != null && roleName in membreData.roles)
        )
      );
    }
    match /membres/{membreEmail} {
      allow create: if (request.resource.data.keys().hasAll(['prenom', 'nom', 'email', 'dateInscription', 'status'])
                    && request.resource.data.status == 'pending') || isAdmin();
      allow read: if request.auth != null && (request.auth.token.email == membreEmail || isAdmin() || isMembreValide());
      allow update: if isAdmin() || 
        (hasRole('gestionnaire') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'role', 'roleRequest', 'roleRequests'])) ||
        (request.auth != null && request.auth.token.email == membreEmail && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roleRequest', 'roleRequests']));
      allow delete: if isAdmin();
    }

    // [SPEC-TOURNEE-04] Address and favorite preferences are accessible only through authenticated server routes.
    match /memberPrivate/{uid} {
      allow read, write: if false;
    }

    
    // [SPEC-PET-CLOSE-01] Collecte close : les signatures historiques restent consultables par les rôles autorisés.
    match /signatures/{sigId} {
      allow create: if false;
      allow read: if isAdmin() || hasRole('correcteur');
      allow update: if hasRole('correcteur');
      allow delete: if isAdmin();
    }
    
    // STATS: Tout le monde peut lire et mettre à jour les compteurs publics
    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mailOutbox/{mailId} {
      // [SPEC-MAIL-03] Campaign PII and recipient lists are accessed only through authenticated server APIs.
      allow read, write: if false;
    }

    match /mailMessageIndex/{messageId} {
      // [SPEC-MAIL-04] Message-ID correlation is private server-only thread metadata.
      allow read, write: if false;
    }

    // [SPEC-MAIL-02] Inbox content and reply threads are only served by the role-checked server API.
    match /mailInbox/{messageId} {
      allow read, write: if false;
      match /replies/{replyId} {
        allow read, write: if false;
      }
    }

    match /mailInboxSyncState/{stateId} {
      allow read, write: if false;
    }

    match /magicLinks/{linkId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // [SPEC-CMS-DRAFT-01] Brouillons CMS : workflow de révision avant publication
    // Les éditeurs peuvent créer un brouillon avec leur propre email.
    // Les admins peuvent tout lire/modifier/supprimer (pour approuver ou rejeter).
    match /cms_drafts/{draftId} {
      // Lecture : admins uniquement
      allow read: if isAdmin();
      // Création : utilisateur authentifié, avec son email en submittedBy
      allow create: if isMembreValide()
        && request.resource.data.submittedBy == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['pageId', 'status', 'submittedBy', 'submittedAt', 'data']);
      // Mise à jour (rejet) et suppression (approbation) : admins uniquement
      allow update, delete: if isAdmin();
    }
  }
}
