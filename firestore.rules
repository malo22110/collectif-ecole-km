rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Règles pour la collection "membres"
    
    // Règles pour la collection "articles"
    
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /commentaires/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /articles/{articleId} {
      // Tout le monde peut lire les articles publiés
      allow read: if resource == null || resource.data.status == 'published' || request.auth != null;
      // Seuls les administrateurs peuvent créer, modifier ou supprimer
      allow create, update, delete: if request.auth != null;
    }

    match /membres/{membreId} {
      // N'importe qui peut soumettre une candidature (création)
      allow create: if request.resource.data.keys().hasAll(['prenom', 'nom', 'email', 'dateInscription', 'status'])
                    && request.resource.data.status == 'pending';
      
      // Seul un administrateur connecté (via Firebase Auth) peut lire, modifier ou supprimer
      allow read, update, delete: if request.auth != null;
    }
  }
}
