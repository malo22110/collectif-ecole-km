rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /commentaires/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if resource == null || resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /presse/{presseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'lecam.malo@gmail.com' || 
        request.auth.token.email == 'contact@collectif-ecole-km.fr' || 
        request.auth.token.email == 'collectif.ecole.km@gmail.com'
      );
    }

    match /membres/{membreId} {
      allow create: if (request.resource.data.keys().hasAll(['prenom', 'nom', 'email', 'dateInscription', 'status'])
                    && request.resource.data.status == 'pending') || isAdmin();
      allow read: if request.auth != null && (request.auth.token.email == resource.data.email || isAdmin());
      allow update, delete: if isAdmin();
    }
    
    // PETITION: Tout le monde peut lire et créer des signatures
    match /signatures/{sigId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }
    
    // STATS: Tout le monde peut lire et mettre à jour les compteurs publics
    match /stats/{statId} {
      allow read, write: if true;
    }

    match /mailOutbox/{mailId} {
      allow create, read, update, delete: if isAdmin();
    }

    match /magicLinks/{linkId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
