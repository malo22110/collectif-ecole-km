rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /articles/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // [SPEC-MAIL-02] Incoming email attachments are private and served through an authenticated API.
    match /mailInbox/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
